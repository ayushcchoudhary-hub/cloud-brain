# Everything is optional. With no .env at all, Cloud Brain runs in memory on the bundled sample wikis.
BACKEND=memory
# OWN_HANDLE=otter            # which wiki folder counts as "yours"
# WIKI_DIR=./sample-wikis     # one subfolder per contributor
# MONTHLY_BUDGET_USDC=20      # simulated spend limits
# PER_PULL_MAX_USDC=5
# CLOUD_BRAIN_MARKETPLACE=false

# Optional Supabase backend (BACKEND=supabase, apply supabase/schema.sql first). Untested since cleanup.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=             # embeddings for Supabase, or SYNTH_MODE=openai
# SYNTH_MODE=extractive
